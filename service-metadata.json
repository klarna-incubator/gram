{
  "service_name": "gram",
  "eu": {
    "staging": {
      "canary_promotion": {
        "strategy": "AUTOMATIC"
      },
      "egress": {
        "security_groups": [
          { "named_security_group": "rds-eu-staging" },
          { "named_security_group": "smtp-eu-staging" },
          { "named_security_group": "ldap-eu-staging" }
        ]
      },
      "env": {
        "HSF_S3_BUCKET": {
          "value": "secdev-qliksense-exporter-staging-source"
        },
        "HSF_S3_KEY": { "value": "hsf-systems-daily.csv" },
        "HSF_AWS_ROLE": {
          "value": "arn:aws:iam::422554941857:role/iam-sync/gram/c2c/gram/eu/staging/gram.c2c_gram"
        },
        "HSF_AWS_EXTERNAL_ID": {
          "value": "73fddbb9-a953-4f1c-9198-16a6113fe681"
        },
        "THREATSAURUS_URL": {
          "value": "https://threatsaurus-eu.staging.c2c.klarna.net/v1/"
        }
      }
    },
    "production": {
      "canary_promotion": {
        "strategy": "AUTOMATIC"
      },
      "egress": {
        "security_groups": [
          { "named_security_group": "rds-eu-production" },
          { "named_security_group": "smtp-eu-production" },
          { "named_security_group": "ldap-eu-production" }
        ]
      },
      "custom_domain_names": [{ "fqdn": "gram.klarna.net" }],
      "env": {
        "HSF_S3_BUCKET": {
          "value": "secdev-qliksense-exporter-production-source"
        },
        "HSF_S3_KEY": { "value": "hsf-systems-daily.csv" },
        "HSF_AWS_ROLE": {
          "value": "arn:aws:iam::715798949107:role/iam-sync/gram/c2c/gram/eu/production/gram.c2c_gram"
        },
        "HSF_AWS_EXTERNAL_ID": {
          "value": "e2105a81-0156-4321-b757-4e3f20aaacac"
        },
        "THREATSAURUS_URL": {
          "value": "https://threatsaurus-eu.production.c2c.klarna.net/v1/"
        }
      }
    }
  },
  "default": {
    "api_version": "v2",
    "automated_maintenance_redeployment": { "enabled": true },
    "minimum_instances": 1,
    "container_size": "xsmall",
    "canary_promotion": {
      "strategy": "CONFIRM",
      "timeout": 1200
    },
    "public_loadbalancer": false,
    "egress": {
      "allowed_destinations": [
        { "destination": "www.googleapis.com", "ports": [443] },
        { "destination": "oauth2.googleapis.com", "ports": [443] },
        { "destination": "accounts.google.com", "ports": [443] },
        { "destination": "iam.googleapis.com", "ports": [443] },
        { "destination": "openidconnect.googleapis.com", "ports": [443] },
        { "destination": "www.googleapis.com", "ports": [443] },
        { "destination": "o24547.ingest.sentry.io", "ports": [443] },
        { "destination": "octane.klarna.net", "ports": [443] },
        { "destination": "sso.klarna.net", "ports": [443] },
        { "destination": "klarna-sandbox-343.atlassian.net", "ports": [443] },
        { "destination": "klarna.atlassian.net", "ports": [443] },
        { "destination": "klarna-dev-admin.oktapreview.com", "ports": [443] },
        {
          "destination": "inbound.production.eu1.smtp-service.klarna.net",
          "ports": [25, 587]
        },
        {
          "destination": "inbound.production.eu2.smtp-service.klarna.net",
          "ports": [25, 587]
        }
      ],
      "security_groups": [{ "named_security_group": "smtp-eu-production" }]
    },
    "clients": {
      "cidr_blocks": ["10.0.0.0/8"]
    },
    "env": {
      "POSTGRES_HOST": { "secret": "/data._providers.postgres.host" },
      "POSTGRES_USER": { "secret": "/data._providers.postgres.user" },
      "POSTGRES_PASSWORD": { "secret": "/data._providers.postgres.password" },
      "POSTGRES_DATABASE": { "secret": "/data._providers.postgres.database" },
      "POSTGRES_PORT": { "secret": "/data._providers.postgres.port" },
      "AUTH_SECRET": { "secret": "/auth.jwt.secret" },
      "EMAIL_HOST": { "secret": "/notifications.providers.email.host" },
      "EMAIL_PORT": { "secret": "/notifications.providers.email.port" },
      "EMAIL_USER": { "secret": "/notifications.providers.email.user" },
      "EMAIL_PASSWORD": { "secret": "/notifications.providers.email.password" },
      "LDAP_BIND_DN": { "secret": "/auth.ldap.binddn" },
      "LDAP_BIND_CREDENTIALS": { "secret": "/auth.ldap.bindcredentials" },
      "JIRA_USER": { "secret": "/jira.user" },
      "JIRA_API_TOKEN": { "secret": "/jira.token" },
      "OIDC_CLIENT_DISCOVER_URL": { "value": "https://sso.klarna.net/" },
      "OIDC_SESSION_SECRET": { "secret": "/auth.oidc.session_secret" },
      "OIDC_CLIENT_ID": { "secret": "/auth.oidc.client_id" },
      "OIDC_CLIENT_SECRET": { "secret": "/auth.oidc.client_secret" },
      "THREATSAURUS_URL": {
        "value": "https://threatsaurus-eu.production.c2c.klarna.net/v1/"
      }
    }
  }
}
