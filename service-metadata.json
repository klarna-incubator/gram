{
  "service_name": "gram",
  "eu": {
    "staging": {
      "canary_promotion": {
        "strategy": "AUTOMATIC"
      },
      "egress": {
        "security_groups": [
          { "named_security_group": "rds-eu-staging" },
          { "named_security_group": "smtp-eu-staging" },
          { "named_security_group": "ldap-eu-staging" }
        ]
      }
    },
    "production": {
      "canary_promotion": {
        "strategy": "AUTOMATIC"
      },
      "egress": {
        "security_groups": [
          { "named_security_group": "rds-eu-production" },
          { "named_security_group": "smtp-eu-production" },
          { "named_security_group": "ldap-eu-production" }
        ]
      },
      "custom_domain_names": [{ "fqdn": "gram.klarna.net" }]
    }
  },
  "default": {
    "api_version": "v2",
    "minimum_instances": 1,
    "container_size": "xsmall",
    "canary_promotion": {
      "strategy": "CONFIRM",
      "timeout": 1200
    },
    "public_loadbalancer": false,
    "egress": {
      "allowed_destinations": [
        { "destination": "www.googleapis.com", "ports": [443] },
        { "destination": "oauth2.googleapis.com", "ports": [443] },
        { "destination": "accounts.google.com", "ports": [443] },
        { "destination": "iam.googleapis.com", "ports": [443] },
        { "destination": "openidconnect.googleapis.com", "ports": [443] },
        { "destination": "www.googleapis.com", "ports": [443] },
        { "destination": "o24547.ingest.sentry.io", "ports": [443] },
        { "destination": "octane.klarna.net", "ports": [443] },
        { "destination": "sso.klarna.net", "ports": [443] },
        { "destination": "klarna-dev-admin.oktapreview.com", "ports": [443] },
        {
          "destination": "inbound.production.eu1.smtp-service.klarna.net",
          "ports": [25, 587]
        },
        {
          "destination": "inbound.production.eu2.smtp-service.klarna.net",
          "ports": [25, 587]
        }
      ],
      "security_groups": [
        {
          "rule": {
            "cidr_blocks": [
              "52.30.236.203/32",
              "54.73.174.245/32",
              "3.73.181.240/32",
              "35.156.176.213/32"
            ],
            "ports": ["25", "587"],
            "description": "Allow smtp traffic to new smtp service"
          }
        }
      ]
    },
    "clients": {
      "cidr_blocks": ["10.0.0.0/8"]
    },
    "env": {
      "POSTGRES_HOST": { "secret": "/data._providers.postgres.host" },
      "POSTGRES_USER": { "secret": "/data._providers.postgres.user" },
      "POSTGRES_PASSWORD": { "secret": "/data._providers.postgres.password" },
      "POSTGRES_DB": { "secret": "/data._providers.postgres.database" },
      "POSTGRES_PORT": { "secret": "/data._providers.postgres.port" },
      "AUTH_SECRET": { "secret": "/auth.jwt.secret" },
      "CSRF_SECRET": { "secret": "/jwt.secret.csrf" },
      "EMAIL_HOST": { "secret": "/notifications.providers.email.host" },
      "EMAIL_PORT": { "secret": "/notifications.providers.email.port" },
      "EMAIL_USER": { "secret": "/notifications.providers.email.user" },
      "EMAIL_PASSWORD": { "secret": "/notifications.providers.email.password" },
      "AUTH_LDAP_BIND_DN": { "secret": "/auth.ldap.binddn" },
      "AUTH_LDAP_BIND_CREDENTIALS": { "secret": "/auth.ldap.bindcredentials" },
      "JIRA_USER": { "secret": "/jira.user" },
      "JIRA_PASSWORD": { "secret": "/jira.password" },
      "AUTH_GOOGLE_CLIENT_SECRET": { "secret": "/auth.google.client_secret" },
      "AUTH_OIDC_SESSION_SECRET": { "secret": "/auth.oidc.session_secret" },
      "AUTH_OIDC_CLIENT_ID": { "secret": "/auth.oidc.client_id" },
      "AUTH_OIDC_CLIENT_SECRET": { "secret": "/auth.oidc.client_secret" }
    }
  }
}
