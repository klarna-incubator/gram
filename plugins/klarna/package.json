    "jsprim": "^2.0.2",
    "ldapts": "^4.2.6",
    "openid-client": "^5.3.2",
    "postman-request": "^2.88.1-postman.33",
    "precond": "^0.2.3",
    "proxy-agent": "^6.3.1",
    "node-fetch": "^3.3.2"
