{
  "origin": "ORIGIN",

  "jira": {
    "token": "JIRA_TOKEN",
    "user": "JIRA_USER",
    "password": "JIRA_PASSWORD"
  },

  "data": {
    "_providers": {
      "postgres": {
        "host": "POSTGRES_HOST",
        "user": "POSTGRES_USER",
        "password": "POSTGRES_PASSWORD",
        "database": "POSTGRES_DB",
        "port": "POSTGRES_PORT"
      }
    }
  },

  "jwt": {
    "secret": {
      "auth": "AUTH_SECRET",
      "csrf": "CSRF_SECRET"
    }
  },

  "auth": {
    "oidc-session-secret": "AUTH_OIDC_SESSION_SECRET",
    "providerOpts": {
      "ldap": {
        "bindDN": "AUTH_LDAP_BIND_DN",
        "bindCredentials": "AUTH_LDAP_BIND_CREDENTIALS"
      },
      "google": {
        "clientSecret": "AUTH_GOOGLE_CLIENT_SECRET"
      }
    }
  },

  "notifications": {
    "providers": {
      "email": {
        "user": "EMAIL_USER",
        "password": "EMAIL_PASSWORD",
        "host": "EMAIL_HOST",
        "port": "EMAIL_PORT"
      }
    }
  }
}
