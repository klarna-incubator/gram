{
  "appPort": 8080,
  "controlPort": 8081,
  "origin": "http://localhost:4726",

  "secrets": {
    "provider": "config"
  },

  "jwt": {
    "ttl": 86400,
    "secret": {
      "auth": "NOT BASE64. SHOULD CRASH. SORRY. DONT USE DEFAULT VALUES <3"
    }
  },

  "auth": {
    "providerOpts": {
      "google": {
        "clientId": "795236967504-kjvh3ouinnnqboilg3vf92v2k6mhijm6.apps.googleusercontent.com"
      },
      "ldap": {
        "url": "ldaps://ldap.klarna.net",
        "searchFilter": "(uid={{username}})",
        "requiredGroup": "access.1288598.stag.system-api-access",
        "roleMap": {
          "admin": ["access.1288598.stag.admins", "domain.security.leads"],
          "reviewer": ["access.1288598.stag.reviewers", "security-champions"],
          "user": ["access.1288598.stag.users", "access.1288598.stag.sso-prod"]
        }
      }
    }
  },

  "log": {
    "layout": "json",
    "level": "info",

    "auditHttp": {
      "excludeKeys": {
        "header": ["authorization", "x-google-id-token", "cookie"],
        "body": ["token"]
      },
      "includeKeys": {
        "header": ["user-agent", "host", "referer", "cache-control", "pragma"]
      },
      "simplified": false
    }
  },

  "cookie": {
    "secure": false,
    "httpOnly": true
  },

  "data": {
    "_providers": {
      "threatsaurus": {
        "baseUrl": "https://threatsaurus-eu.staging.c2c.klarna.net/v1/"
      }
    }
  },

  "allowedSrc": {
    "img": ["https:"],
    "connect": ["https://o24547.ingest.sentry.io"]
  },

  "menu": [
    {
      "name": "Github",
      "path": "https://github.com/klarna-incubator/gram"
    },
    {
      "name": "Feedback",
      "path": "https://docs.google.com/forms/d/e/1FAIpQLSfVTLCR_VHTzIhDZ8MRFLpfm58LNlf0zICS2brYMOok7LrURA/viewform?usp=sf_link"
    },
    {
      "name": "Docs",
      "path": "https://kep.klarna.net/docs/secure-development/threat_modeling/threat_modeling/"
    },
    {
      "name": "Support",
      "path": "https://klarna.slack.com/archives/C04RMEJ8VFD"
    }
  ]
